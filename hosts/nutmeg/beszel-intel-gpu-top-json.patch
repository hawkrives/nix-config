+
+// topLevelValues passes intel_gpu_top's output through as a plain stream of
+// JSON objects: it drops the brackets and commas between samples, outside any
+// object or string, so samples decode one at a time whether or not the
+// version prints them.
+type topLevelValues struct {
+	r        io.Reader
+	depth    int
+	inString bool
+	escaped  bool
+}
+
+func (t *topLevelValues) Read(p []byte) (int, error) {
+	for {
+		n, err := t.r.Read(p)
+		out := p[:0]
+		for _, b := range p[:n] {
+			if t.inString {
+				switch {
+				case t.escaped:
+					t.escaped = false
+				case b == '\\':
+					t.escaped = true
+				case b == '"':
+					t.inString = false
+				}
+				out = append(out, b)
+				continue
+			}
+			switch b {
+			case '"':
+				t.inString = true
+			case '{':
+				t.depth++
+			case '}':
+				t.depth--
+			case '[', ']', ',':
+				if t.depth == 0 {
+					continue
+				}
+			}
+			out = append(out, b)
+		}
+		if len(out) > 0 || err != nil {
+			return len(out), err
+		}
+	}
+}
